    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b",
    "check:overrides": "node scripts/check-overrides.mjs",
    "clean": "rm -rf dist",
    "snapshot:registry": "node scripts/snapshot-registry.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@google/generative-ai": "^0.24.1",
