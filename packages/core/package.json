    "url": "git+https://github.com/faraa2m/tokenometer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/faraa2m/tokenometer/issues"
  },
  "keywords": [
    "ai",
    "anthropic",
    "claude",
    "cl100k",
    "cost",
    "gemini",
