{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build && npm run build -w @tokenometer/web",
  "outputDirectory": "packages/web/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tokenometer.dev" }],
      "destination": "https://www.tokenometer.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tokenometer.app" }],
      "destination": "https://www.tokenometer.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.tokenometer.app" }],
      "destination": "https://www.tokenometer.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tokenometer.io" }],
      "destination": "https://www.tokenometer.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.tokenometer.io" }],
      "destination": "https://www.tokenometer.dev/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/:path((?!assets/|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ]
}
